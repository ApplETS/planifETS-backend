APP_ENV=development

PORT=3001

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=planifetsDB
# DATABASE_URL="postgresql://postgres:postgres@db:5432/planifetsDB?schema=public" # docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/planifetsDB?schema=public" # local dev

# Optional
LOG_LEVELS="log,error,warn" # Log levels: "log,error,warn,debug,fatal,verbose"
APP_GIT_SHORT_SHA=localdev

# Jobs schedule (cron expression)
# dev: daily at 3am        → "0 3 * * *"
# staging: weekly Monday 3am → "0 3 * * 1"
# prod: biweekly (every 14d) → "0 3 1,15 * *"
JOBS_CRON_SCHEDULE="0 */12 * * *"

# Monitoring
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# Qdrant (for seed:qdrant script)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="courses"
